# ignore compiled modules, dependencies, etc.
*.mod
*.d
*.o
*.a
*.la
*.lo
*.so
*.so.0*

# ignore binaries in folders
*_lib/*
*_test/*
.libs/*

# ignore configure.ac
# The correct version of these file
# and in configure_*.ac,
# copied over by the reconfigure or configure script
configure.ac

# ignore Makefile.am
# The correct version of these files
# are in Makefile_*.am
# copied over by the reconfigure script
# or by the configure script
Makefile.am

# ignore Makefile.in from automake
# The correct version of these files
# are in Makefile_*
# and in Makefile_*.in,
# copied over by the configure script
# or generated by the reconfigure script
Makefile.in

# ignore Makefile and config.status from configure
# The correct version of these files
# are generated by the reconfigure or configure script
Makefile
config.status

# ignore configuration scripts from autoreconf
# The correct version of these files
# are in aclocal_*.m4
# and in libtool_*
# and in configure_*,
# copied over by the configure script
# or generated by the reconfigure script
aclocal.m4
configure
libtool

# ignore configuration files from configure
# generated by the reconfigure or configure script
aclocal.m4

# ignore autoconf log files/folders
autom4te.cache/*
config.log

# ignore userconfig
userlibraryconfig

# ignore compiled executables
*_real_sp
*_real_dp
*_cmplx_sp
*_cmplx_dp
