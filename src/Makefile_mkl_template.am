#flags for linking MKL
AM_LDFLAGS = -Wl,--no-as-needed -lmkl_gf_ilp64 -lmkl_sequential -lmkl_core -lpthread -lm -ldl
#Other things to be set
#OPENMPFLAGS = -fopenmp
PROFILEFLAGS = -pg
RELEASEFLAGS = -O3 -flto
# compiler string
FC = gfortran -fdefault-integer-8 -std=f2008 -cpp -I$(MKLROOT)/include $(AM_LDFLAGS)
DEBUGFLAGS = -Og -pedantic -Wall -Wextra -g -fbacktrace\
-ffpe-trap=overflow,underflow,denormal -fcheck=bounds
