#flags for linking MKL
AM_LDFLAGS = -Wl,--no-as-needed -lmkl_gf_ilp64 -lmkl_sequential -lmkl_core -lpthread -lm -ldl
# compiler string
FC = gfortran -fdefault-integer-8 -std=f2008 -cpp -I$(MKLROOT)/include $(AM_LDFLAGS)
# library sources
libkrylov_real_sp_la_SOURCES = basekinds.f90 floatformat_sp.f90 \
basetypes_real.f90 blastypes_blas_real_sp.f90 arrayfile.f90 \
libkrylovinterface_real_sp.f90 libkrylovsolver.f90
libkrylov_cmplx_sp_la_SOURCES = basekinds.f90 floatformat_sp.f90 \
basetypes_cmplx.f90 blastypes_blas_cmplx_sp.f90 arrayfile.f90 \
libkrylovinterface_cmplx_sp.f90 libkrylovsolver.f90
libkrylov_real_dp_la_SOURCES = basekinds.f90 floatformat_dp.f90 \
basetypes_real.f90 blastypes_blas_real_dp.f90 arrayfile.f90 \
libkrylovinterface_real_dp.f90 \
libkrylovsolver.f90
libkrylov_cmplx_dp_la_SOURCES = basekinds.f90 floatformat_dp.f90 \
basetypes_cmplx.f90 blastypes_blas_cmplx_dp.f90 arrayfile.f90 \
libkrylovinterface_cmplx_dp.f90 libkrylovsolver.f90
