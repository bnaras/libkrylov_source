# This is the autoconf file for the libkrylov src folder
# Hence the name of the package
# Version number is beta
# No bug report address 
AC_INIT([libkrylov],[beta])

# Safety check that this is the source directory
AC_CONFIG_SRCDIR(basekinds.f90)

# Set up auxiliary build folder for auxiliary build tools
AC_CONFIG_AUX_DIR([build_aux])

# call autoconf-archive macros installed from
# using "git clone git://git.sv.gnu.org/autoconf-archive.git"
# in this src directory
AC_CONFIG_MACRO_DIR([autoconf-archive/m4])

# Starting Automake, ignore GNU standards with 'foreign'
AM_INIT_AUTOMAKE([-Wall -Werror foreign])

# Looking for newer fortran compiler 
#(CODE WILL NOT WORK WITHOUT 2003 FEATURES)
AC_PROG_FC([gfortran],[])

#Looking for F77 compiler flags, possibly for BLAS/LAPACK
AC_F77_LIBRARY_LDFLAGS
AC_F77_DUMMY_MAIN

# linker for libraries
AC_FC_LIBRARY_LDFLAGS

# dealing with .f versus .f90 extensions
AC_FC_SRCEXT([f90])

# Ensure that longer than 80 character source code lines are possible,
# We try to ensure all lines are less that 80 characters
AC_FC_FREEFORM

# Looking for BLAS
#(Most blastypes_*.f90 use BLAS routines)
#(Macro from Autoconf-archive
AX_BLAS([AC_MSG_NOTICE([found BLAS])],[AC_MSG_ERROR([no BLAS])])

# Looking for LAPACK
# required linking $LAPACK_LIBS $ BLAS_LIBS $LIBS $FLIBS
AX_LAPACK([AC_MSG_NOTICE([found LAPACK])],[AC_MSG_ERROR([no LAPACK])])

# Print out of full linker for checking
AC_MSG_NOTICE([The next message is the entire linker for BLAS and LAPack])
AC_MSG_NOTICE([$LAPACK_LIBS $BLAS_LIBS $LIBS $FLIBS])

#Looking for RANLIB for archiver
#AC_PROG_RANLIB

#Looking for program ar, archiver for libraries
AM_PROG_AR

# Looking for libtool
AC_PROG_LIBTOOL

# Create Makefile for libkrylov src directory
AC_CONFIG_FILES([Makefile])

# Generate configure script to run
AC_OUTPUT
