# compiler string
#Other things to be set
OPENMPFLAGS = -fopenmp
PROFILEFLAGS = -pg
RELEASEFLAGS = -O3 -flto
FC = gfortran -fdefault-integer-8 -std=f2008 -cpp 
DEBUGFLAGS = -Og -pedantic -Wall -Wextra -g -fbacktrace\
-ffpe-trap=overflow,underflow,denormal -fcheck=bounds
# library sources
libkrylov_real_sp_la_SOURCES = basekinds.f90 floatformat_sp.f90 \
basetypes_real.f90 blastypes_base_real_sp.f90 arrayfile.f90 \
libkrylovinterface_real_sp.f90 \
libkrylovsolver.f90
libkrylov_cmplx_sp_la_SOURCES = basekinds.f90 floatformat_sp.f90 \
basetypes_cmplx.f90 blastypes_base_cmplx_sp.f90 arrayfile.f90 \
libkrylovinterface_cmplx_sp.f90 libkrylovsolver.f90
libkrylov_real_dp_la_SOURCES = basekinds.f90 floatformat_dp.f90 \
basetypes_real.f90 blastypes_base_real_dp.f90 arrayfile.f90 \
libkrylovinterface_real_dp.f90 \
libkrylovsolver.f90
libkrylov_cmplx_dp_la_SOURCES = basekinds.f90 floatformat_dp.f90 \
