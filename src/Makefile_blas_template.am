#flags for linking BLAS/LAPACK
AM_LDFLAGS = @LAPACK_LIBS@ @BLAS_LIBS@ @LIBS@ @FLIBS@
#Other things to be set
#OPENMPFLAGS = -fopenmp
PROFILEFLAGS = -pg
RELEASEFLAGS = -O3 -flto
DEBUGFLAGS = -Og -pedantic -Wall -Wextra -g -fbacktrace\
-ffpe-trap=overflow,underflow,denormal -fcheck=bounds
# compiler string
FC = gfortran -fdefault-integer-8 -std=f2008 -cpp -static $(AM_LDFLAGS) $(DEBUGFLAGS)
# library sources
libkrylov_real_sp_la_SOURCES = \
libkrylovinterface_real_sp.f90 interface_real_sp.f90 \
basekinds.f90 floatformat_sp.f90 \
basetypes_real.f90 blastypes_blas_real_sp.f90 arrayfile.f90 \
libkrylovsolver.f90 libkrylovsolver_real_sp.f90
libkrylov_cmplx_sp_la_SOURCES = \
libkrylovinterface_cmplx_sp.f90 interface_cmplx_sp.f90 \
basekinds.f90 floatformat_sp.f90 \
basetypes_cmplx.f90 blastypes_blas_cmplx_sp.f90 arrayfile.f90 \
libkrylovsolver.f90 libkrylovsolver_cmplx_sp.f90
libkrylov_real_dp_la_SOURCES = \
libkrylovinterface_real_dp.f90 interface_real_dp.f90 \
basekinds.f90 floatformat_dp.f90 \
basetypes_real.f90 blastypes_blas_real_dp.f90 arrayfile.f90 \
libkrylovsolver.f90 libkrylovsolver_real_dp.f90
libkrylov_cmplx_dp_la_SOURCES = \
libkrylovinterface_cmplx_dp.f90 interface_cmplx_dp.f90 \
basekinds.f90 floatformat_dp.f90 \
basetypes_cmplx.f90 blastypes_blas_cmplx_dp.f90 arrayfile.f90 \
libkrylovsolver.f90 libkrylovsolver_cmplx_dp.f90
