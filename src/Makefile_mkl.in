cmplx_dp_arrayfiledir = $(PWD)/cmplx_dp_test
test_arrayfile_cmplx_dp_SOURCES = test_arrayfile.f90
test_arrayfile_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# type(base) elementary operations test
cmplx_dp_basetypedir = $(PWD)/cmplx_dp_test
test_basetypes_cmplx_dp_SOURCES = test_basetypes.f90
test_basetypes_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# type(base) array operations test
cmplx_dp_blastypedir = $(PWD)/cmplx_dp_test
test_blastypes_cmplx_dp_SOURCES = test_blastypes.f90
test_blastypes_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
