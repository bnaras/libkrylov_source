#cmplx_dp_krylovtype_PROGRAMS = test_krylovtypes_a_cmplx_dp
#test_krylovtypes_a_cmplx_dp_SOURCES = test_krylovtypes_a.f90
#test_krylovtypes_a_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# check of quality for restart files
cmplx_dp_restartdir = $(PWD)/cmplx_dp_lib
restart_check_libkrylov_cmplx_dp_SOURCES = restart_check.f90
restart_check_libkrylov_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# generate vandermonde matrix for driver1a
cmplx_dp_vm_problem1adir = $(PWD)/cmplx_dp_test
problem1a_vm_cmplx_dp_SOURCES = problem_1a_vandermonde.f90
problem1a_vm_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# generate problem for driver1a
#cmplx_dp_rand_problem1adir = $(PWD)/cmplx_dp_test
#cmplx_dp_rand_problem1a_PROGRAMS = problem1a_rand_cmplx_dp
#problem1a_rand_cmplx_dp_SOURCES = problem_1a_random.f90
#problem1a_rand_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# generate problem for driver1b
#cmplx_dp_rand_problem1bdir = $(PWD)/cmplx_dp_test
#cmplx_dp_rand_problem1b_PROGRAMS = problem1b_rand_cmplx_dp
#problem1b_rand_cmplx_dp_SOURCES = problem_1b_random.f90
#problem1b_rand_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# generate problem for driver1c
#cmplx_dp_rand_problem1cdir = $(PWD)/cmplx_dp_test
#cmplx_dp_rand_problem1c_PROGRAMS = problem1c_rand_cmplx_dp
#problem1c_rand_cmplx_dp_SOURCES = problem_1c_random.f90
#problem1c_rand_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# driver1a - program for calling a_solver on a problem on file
cmplx_dp_driver1adir = $(PWD)/cmplx_dp_test
driver1a_cmplx_dp_SOURCES = driver_1a_cmplx_dp.f90
driver1a_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# driver1b - program for calling b_solver on a problem on file
cmplx_dp_driver1bdir = $(PWD)/cmplx_dp_test
driver1b_cmplx_dp_SOURCES = driver_1b_cmplx_dp.f90
driver1b_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
# driver1c - program for calling c_solver on a problem on file
cmplx_dp_driver1cdir = $(PWD)/cmplx_dp_test
driver1c_cmplx_dp_SOURCES = driver_1c_cmplx_dp.f90
driver1c_cmplx_dp_LDADD = libkrylov_cmplx_dp.la
#flags for linking MKL
AM_LDFLAGS = -Wl,--no-as-needed -lmkl_gf_ilp64 -lmkl_sequential -lmkl_core -lpthread -lm -ldl
# library sources
libkrylov_real_sp_la_SOURCES = basekinds.f90 floatformat_sp.f90 \
basetypes_real.f90 blastypes_blas_real_sp.f90 arrayfile.f90 \
libkrylovinterface_real_sp.f90 libkrylovsolver.f90

libkrylov_cmplx_sp_la_SOURCES = basekinds.f90 floatformat_sp.f90 \
basetypes_cmplx.f90 blastypes_blas_cmplx_sp.f90 arrayfile.f90 \
libkrylovinterface_cmplx_sp.f90 libkrylovsolver.f90

libkrylov_real_dp_la_SOURCES = basekinds.f90 floatformat_dp.f90 \
basetypes_real.f90 blastypes_blas_real_dp.f90 arrayfile.f90 \
libkrylovinterface_real_dp.f90 \
libkrylovsolver.f90

libkrylov_cmplx_dp_la_SOURCES = basekinds.f90 floatformat_dp.f90 \
basetypes_cmplx.f90 blastypes_blas_cmplx_dp.f90 arrayfile.f90 \
libkrylovinterface_cmplx_dp.f90 libkrylovsolver.f90

all: all-am

.SUFFIXES:
.SUFFIXES: .f90 .lo .o .obj
am--refresh: Makefile
	@:
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      echo ' cd $(srcdir) && $(AUTOMAKE) --foreign'; \
	      $(am__cd) $(srcdir) && $(AUTOMAKE) --foreign \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    echo ' $(SHELL) ./config.status'; \
	    $(SHELL) ./config.status;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__depfiles_maybe)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__depfiles_maybe);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	$(SHELL) ./config.status --recheck

$(top_srcdir)/configure:  $(am__configure_deps)
	$(am__cd) $(srcdir) && $(AUTOCONF)
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	$(am__cd) $(srcdir) && $(ACLOCAL) $(ACLOCAL_AMFLAGS)
$(am__aclocal_m4_deps):

install-cmplx_dp_libLTLIBRARIES: $(cmplx_dp_lib_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(cmplx_dp_lib_LTLIBRARIES)'; test -n "$(cmplx_dp_libdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(cmplx_dp_libdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(cmplx_dp_libdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(cmplx_dp_libdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(cmplx_dp_libdir)"; \
	}

uninstall-cmplx_dp_libLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(cmplx_dp_lib_LTLIBRARIES)'; test -n "$(cmplx_dp_libdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(cmplx_dp_libdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(cmplx_dp_libdir)/$$f"; \
	done

clean-cmplx_dp_libLTLIBRARIES:
	-test -z "$(cmplx_dp_lib_LTLIBRARIES)" || rm -f $(cmplx_dp_lib_LTLIBRARIES)
	@list='$(cmplx_dp_lib_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

