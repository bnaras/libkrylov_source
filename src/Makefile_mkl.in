	$(AM_V_FCLD)$(FCLINK) -rpath $(real_sp_libdir) $(libkrylov_real_sp_la_OBJECTS) $(libkrylov_real_sp_la_LIBADD) $(LIBS)
install-cmplx_dp_arrayfilePROGRAMS: $(cmplx_dp_arrayfile_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(cmplx_dp_arrayfile_PROGRAMS)'; test -n "$(cmplx_dp_arrayfiledir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(cmplx_dp_arrayfiledir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(cmplx_dp_arrayfiledir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(cmplx_dp_arrayfiledir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(cmplx_dp_arrayfiledir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-cmplx_dp_arrayfilePROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(cmplx_dp_arrayfile_PROGRAMS)'; test -n "$(cmplx_dp_arrayfiledir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(cmplx_dp_arrayfiledir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(cmplx_dp_arrayfiledir)" && rm -f $$files

clean-cmplx_dp_arrayfilePROGRAMS:
	@list='$(cmplx_dp_arrayfile_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list
