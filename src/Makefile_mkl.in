libkrylov_cmplx_dp.la: $(libkrylov_cmplx_dp_la_OBJECTS) $(libkrylov_cmplx_dp_la_DEPENDENCIES) $(EXTRA_libkrylov_cmplx_dp_la_DEPENDENCIES) 
	$(AM_V_FCLD)$(FCLINK) -rpath $(cmplx_dp_libdir) $(libkrylov_cmplx_dp_la_OBJECTS) $(libkrylov_cmplx_dp_la_LIBADD) $(LIBS)

libkrylov_cmplx_sp.la: $(libkrylov_cmplx_sp_la_OBJECTS) $(libkrylov_cmplx_sp_la_DEPENDENCIES) $(EXTRA_libkrylov_cmplx_sp_la_DEPENDENCIES) 
	$(AM_V_FCLD)$(FCLINK) -rpath $(cmplx_sp_libdir) $(libkrylov_cmplx_sp_la_OBJECTS) $(libkrylov_cmplx_sp_la_LIBADD) $(LIBS)

libkrylov_real_dp.la: $(libkrylov_real_dp_la_OBJECTS) $(libkrylov_real_dp_la_DEPENDENCIES) $(EXTRA_libkrylov_real_dp_la_DEPENDENCIES) 
	$(AM_V_FCLD)$(FCLINK) -rpath $(real_dp_libdir) $(libkrylov_real_dp_la_OBJECTS) $(libkrylov_real_dp_la_LIBADD) $(LIBS)

